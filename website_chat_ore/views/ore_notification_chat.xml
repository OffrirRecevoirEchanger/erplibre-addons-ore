<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ore_notification_chat_view_form" model="ir.ui.view">
        <field name="name">ore_notification_chat_form</field>
        <field name="model">ore.notification.chat</field>
        <field name="arch" type="xml">
            <form string="Titre">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <field name="group_id" />
                        <field name="membre_notify_id" />
                        <field name="is_read" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ore_notification_chat_view_graph" model="ir.ui.view">
        <field name="name">ore_notification_chat_graph</field>
        <field name="model">ore.notification.chat</field>
        <field name="arch" type="xml">
            <graph string="Ore notification chat">
                <field name="name" type="row" />
                <field name="group_id" type="row" />
                <field name="is_read" type="row" />
                <field name="membre_notify_id" type="row" />
            </graph>
        </field>
    </record>

    <record id="ore_notification_chat_view_kanban" model="ir.ui.view">
        <field name="name">ore_notification_chat_kanban</field>
        <field name="model">ore.notification.chat</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" />
                <field name="group_id" />
                <field name="is_read" />
                <field name="membre_notify_id" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <ul>
                                    <li class="mb4">
                                        <strong>
                                            <field name="name" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="group_id" />
                                        </strong>
                                    </li>
                                    <li class="text-success float-right mb4" t-if="record.is_read.raw_value">
                                        <i aria-label="Ok" class="fa fa-circle" role="img" title="Ok" />
                                    </li>
                                    <li class="text-danger float-right mb4" t-if="!record.is_read.raw_value">
                                        <i aria-label="Invalid" class="fa fa-circle" role="img" title="Invalid" />
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="membre_notify_id" />
                                        </strong>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ore_notification_chat_view_pivot" model="ir.ui.view">
        <field name="name">ore_notification_chat_pivot</field>
        <field name="model">ore.notification.chat</field>
        <field name="arch" type="xml">
            <pivot string="Ore notification chat">
                <field name="name" type="row" />
                <field name="group_id" type="row" />
                <field name="is_read" type="row" />
                <field name="membre_notify_id" type="row" />
            </pivot>
        </field>
    </record>

    <record id="ore_notification_chat_view_search" model="ir.ui.view">
        <field name="name">ore_notification_chat_search</field>
        <field name="model">ore.notification.chat</field>
        <field name="arch" type="xml">
            <search string="Ore notification chat">
                <filter domain="[('name','!=',False)]" name="name" string="Name" />
                <filter domain="[('group_id','!=',False)]" name="group_id" string="Group" />
                <filter domain="[('is_read','=',True)]" name="is_read" string="Is Read" />
                <filter domain="[('membre_notify_id','!=',False)]" name="membre_notify_id" string="Membre Notify" />
            </search>
        </field>
    </record>

    <record id="ore_notification_chat_view_tree" model="ir.ui.view">
        <field name="name">ore_notification_chat_tree</field>
        <field name="model">ore.notification.chat</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="group_id" />
                <field name="is_read" />
                <field name="membre_notify_id" />
            </tree>
        </field>
    </record>

    <act_window
        id="ore_notification_chat_notification_chat_action_window"
        name="Notification chat"
        res_model="ore.notification.chat"
        view_mode="kanban,tree,pivot,graph,form"
    />
</odoo>
