<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="template_votre_contact_full_inherit" inherit_id="website_ore.template_votre_contact_full">
        <xpath expr="//div[hasclass('buttons')]" position="inside">
            <a
                ng-href="/notification#!?section=message&amp;membre={{contact_info.id}}"
                ng-if="!hide_votre_contact_to_contact"
            >
                <div class="btn btn-beta rounded-circle">
                    <span ng-if="contact_info.genre === 'femme'">La</span>
                    <span ng-if="contact_info.genre !== 'femme'">Le</span>
                    contacter
                </div>
            </a>
        </xpath>
    </template>
    <template id="template_clan_details_generic_inherit" inherit_id="website_ore.template_clan_details_generic">
        <xpath expr="//nav[hasclass('profil_left')]" position="inside">
            <a
                id="btn_start_clavardage_from_clan"
                ng-href="/notification#!?section=message&amp;clan={{page_communaute_clan_info.id}}"
                ng-if="page_communaute_clan_info_is_into_clan"
            >
                <div class="profil btn btn-epsilon rounded-circle adapt-text-epsilon-color">
                    <span class="fa fa-comments-o adapt-text-epsilon-color" />
                    Clavardage
                </div>
            </a>
        </xpath>
    </template>
    <template id="layout_website_chat" inherit_id="website_ore.layout">
        <xpath
            expr="//div[hasclass('menu_message_and_notification')]/div[hasclass('dropdown-nav')]/button[@id='BtnTabNotifications']"
            position="before"
        >
            <button id="BtnTabMessages">Messages</button>
        </xpath>

        <xpath expr="//div[hasclass('menu_message_and_notification')]/p" position="replace">
            <p style="font-size: 1.5rem;">Messages et notifications</p>
        </xpath>

        <xpath
            expr="//div[hasclass('menu_message_and_notification')]/div[hasclass('dropdown-cat')]/div[@id='tabMessages']"
            position="attributes"
        >
            <attribute name="style" />
        </xpath>

        <xpath
            expr="//div[hasclass('menu_message_and_notification')]/div[hasclass('dropdown-cat')]/div[@id='tabNotifications']"
            position="attributes"
        >
            <attribute name="style">display: none</attribute>
        </xpath>

        <xpath expr="//span[hasclass('badge-over-fa')]" position="replace">
            <span
                id="badge_notification_all_count"
                class="badge-over-fa"
                ng-if="lst_notification.length > 0 || lst_membre_message.length > 0 || lst_clan_message.length > 0"
            >
                {{lst_notification_unread.length + lst_membre_message.length + lst_clan_message.length}}
            </span>
            <span style="display:none;">
                {{lst_notification.length}}
                {{lst_notification_unread.length}}
                {{lst_membre_message.length}}
                {{lst_clan_message.length}}
            </span>
        </xpath>

        <xpath expr="//div[hasclass('menu_chat')]/../../.." position="attributes">
            <attribute name="ng-controller">ChatController</attribute>
        </xpath>

        <xpath expr="//div[hasclass('menu_chat')]" position="inside">
            <div class="tab-items-container">
                <a
                    role="menuitem"
                    class="dropdown-item"
                    ng-href="/notification#!?section=message&amp;membre={{msg.id}}"
                    ng-repeat="msg in lst_membre_message"
                >
                    <div class="cat activite btn">
                        <img class="activite_img img-fluid rounded-circle" ng-src="{{ msg.ma_photo }}" />
                        <div class="infos">
                            <span class="activite_title">{{msg.resume_msg}}</span>
                            <span class="activite_auteur">{{msg.name}}</span>
                        </div>
                        <div class="infos right">
                            <span>{{msg.last_date}}</span>
                        </div>
                    </div>
                </a>
                <a
                    role="menuitem"
                    class="dropdown-item"
                    ng-href="/notification#!?section=message&amp;clan={{msg.clan_id}}"
                    ng-repeat="msg in lst_clan_message"
                >
                    <div class="cat activite btn">
                        <img class="activite_img img-fluid rounded-circle" ng-src="{{ msg.ma_photo }}" />
                        <div class="infos">
                            <span class="activite_title">{{msg.resume_msg}}</span>
                            <span class="activite_auteur">{{msg.name}}</span>
                        </div>
                        <div class="infos right">
                            <span>{{msg.last_date}}</span>
                        </div>
                    </div>
                </a>
            </div>
            <a role="menuitem" href="/notification#!?section=message" class="dropdown-item">
                <div class="cat activite btn btn-primary">
                    <font class="adapt-text-primary-color" style="font-size: 1rem;">Voir tous les messages</font>
                </div>
            </a>
        </xpath>
    </template>
</odoo>
