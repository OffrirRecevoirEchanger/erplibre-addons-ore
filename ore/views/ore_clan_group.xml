<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ore_clan_group_view_form" model="ir.ui.view">
        <field name="name">ore_clan_group_form</field>
        <field name="model">ore.clan.group</field>
        <field name="arch" type="xml">
            <form string="Titre">
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                    <group>
                        <field name="clan_id" />
                    </group>
                    <group>
                        <field name="membre_create_id" />
                    </group>
                    <group>
                        <field name="membre_list_ids" />
                    </group>
                    <group>
                        <field name="membre_responsable_ids" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ore_clan_group_view_graph" model="ir.ui.view">
        <field name="name">ore_clan_group_graph</field>
        <field name="model">ore.clan.group</field>
        <field name="arch" type="xml">
            <graph string="Ore clan group">
                <field name="name" type="row" />
                <field name="clan_id" type="row" />
                <field name="membre_create_id" type="row" />
            </graph>
        </field>
    </record>

    <record id="ore_clan_group_view_kanban" model="ir.ui.view">
        <field name="name">ore_clan_group_kanban</field>
        <field name="model">ore.clan.group</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" />
                <field name="clan_id" />
                <field name="membre_create_id" />
                <field name="membre_list_ids" />
                <field name="membre_responsable_ids" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <ul>
                                    <li class="mb4">
                                        <strong>
                                            <field name="name" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="clan_id" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="membre_create_id" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="membre_list_ids" />
                                        </strong>
                                    </li>
                                    <li class="mb4">
                                        <strong>
                                            <field name="membre_responsable_ids" />
                                        </strong>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ore_clan_group_view_pivot" model="ir.ui.view">
        <field name="name">ore_clan_group_pivot</field>
        <field name="model">ore.clan.group</field>
        <field name="arch" type="xml">
            <pivot string="Ore clan group">
                <field name="name" type="row" />
                <field name="clan_id" type="row" />
                <field name="membre_create_id" type="row" />
            </pivot>
        </field>
    </record>

    <record id="ore_clan_group_view_search" model="ir.ui.view">
        <field name="name">ore_clan_group_search</field>
        <field name="model">ore.clan.group</field>
        <field name="arch" type="xml">
            <search string="Ore clan group">
                <filter domain="[('name','!=',False)]" name="name" string="Name" />
                <filter domain="[('clan_id','!=',False)]" name="clan_id" string="Clan" />
                <filter domain="[('membre_create_id','!=',False)]" name="membre_create_id" string="Membre Create" />
                <filter domain="[('membre_list_ids','!=',False)]" name="membre_list_ids" string="Membre List" />
                <filter
                    domain="[('membre_responsable_ids','!=',False)]"
                    name="membre_responsable_ids"
                    string="Membre Responsable"
                />
            </search>
        </field>
    </record>

    <record id="ore_clan_group_view_tree" model="ir.ui.view">
        <field name="name">ore_clan_group_tree</field>
        <field name="model">ore.clan.group</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="clan_id" />
                <field name="membre_create_id" />
                <field name="membre_list_ids" />
                <field name="membre_responsable_ids" />
            </tree>
        </field>
    </record>

    <act_window
        id="ore_clan_group_clan_group_action_window"
        name="Clan group"
        res_model="ore.clan.group"
        view_mode="kanban,tree,pivot,graph,form"
    />
</odoo>
