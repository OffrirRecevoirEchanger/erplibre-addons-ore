<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ore_echange_service_notification_view_form" model="ir.ui.view">
        <field name="name">ore_echange_service_notification_form</field>
        <field name="model">ore.echange.service.notification</field>
        <field name="arch" type="xml">
            <form string="Titre">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-archive" name="toggle_active" type="object">
                            <field name="active" widget="boolean_button" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <field name="echange_service_id" />
                        <field name="membre_id" />
                        <field name="membre_from_id" />
                        <field name="type_notification" />
                        <field name="is_read" />
                        <field name="clan_invited_id" />
                        <field name="clan_new_id" />
                        <field name="membre_logo" />
                        <field name="broadcast_membre" />
                        <field name="broadcast_public" />
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" options="{'post_refresh': 'recipients'}" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="ore_echange_service_notification_view_graph" model="ir.ui.view">
        <field name="name">ore_echange_service_notification_graph</field>
        <field name="model">ore.echange.service.notification</field>
        <field name="arch" type="xml">
            <graph string="Ore clan">
                <field name="name" type="row" />
            </graph>
        </field>
    </record>

    <record id="ore_echange_service_notification_view_kanban" model="ir.ui.view">
        <field name="name">ore_echange_service_notification_kanban</field>
        <field name="model">ore.echange.service.notification</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" />
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <ul>
                                    <li class="mb4">
                                        <strong>
                                            <field name="name" />
                                        </strong>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ore_echange_service_notification_view_pivot" model="ir.ui.view">
        <field name="name">ore_echange_service_notification_pivot</field>
        <field name="model">ore.echange.service.notification</field>
        <field name="arch" type="xml">
            <pivot string="Ore clan">
                <field name="name" type="row" />
            </pivot>
        </field>
    </record>

    <record id="ore_echange_service_notification_view_search" model="ir.ui.view">
        <field name="name">ore_echange_service_notification_search</field>
        <field name="model">ore.echange.service.notification</field>
        <field name="arch" type="xml">
            <search string="Ore clan">
                <filter domain="[('name','!=',False)]" name="name" string="Name" />
            </search>
        </field>
    </record>

    <record id="ore_echange_service_notification_view_tree" model="ir.ui.view">
        <field name="name">ore_echange_service_notification_tree</field>
        <field name="model">ore.echange.service.notification</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>

    <act_window
        id="ore_echange_service_notification_clan_action_window"
        name="Clan"
        res_model="ore.echange.service.notification"
        view_mode="kanban,tree,pivot,graph,form"
    />
</odoo>
